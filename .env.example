# ─── Database ───────────────────────────────────────────────
# Local: started by `npm run db:start` (or automatically by `npm run dev`).
# Production: any PostgreSQL connection string.
DATABASE_URL=postgres://brandify:brandify_local@127.0.0.1:54329/brandify

# ─── Auth ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the site (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Media storage ──────────────────────────────────────────
# "local" stores uploads on disk (served via /media/*). Needs a persistent disk in production.
STORAGE_DRIVER=local
# Optional: where local uploads are stored (default: ./storage/uploads)
UPLOADS_DIR=

# ─── Notifications (optional, future) ───────────────────────
# Leave empty to disable email notifications on new leads.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
